[resource]
script = ExtResource("1_45o8a")
npc_name = "Norella"
dialogue = Array[String](["as you know, our neighbors in space are losing power and we are unable to communitacte with them", "Unfortunately, there knowledge about circuits is......", "lets say its out dated. If we don't act soon they will lose all power and all communication will be lost! I dread what could happen to them in such a dark world....", "Anyways.. I don't want to bore you to begin training you need to learn a few things, we will start by picking up that note over there the glowing one, press 'X' to pick it up", "come to me again when you are done. "])
metadata/_custom_type_script = "uid://dkh34p78b3sbj"
